# Nuxt Auth Configuration
# Origen de tu app (para construir URLs internas en producción)
AUTH_ORIGIN=http://localhost:3000

# Secreto para firmar/encriptar el JWT (genera uno seguro)
# Sugerencia: ejecuta `npx auth secret` y pega el valor aquí
AUTH_SECRET=pon-aqui-un-secreto-largo-y-aleatorio

# Backend API Configuration
# URL del backend de autenticación
NUXT_PUBLIC_BACKEND_API_URL=http://localhost:5000

# Production Configuration (comentado por defecto)
# AUTH_ORIGIN=https://tu-dominio.com
# NUXT_PUBLIC_BACKEND_API_URL=https://api.tu-dominio.com
